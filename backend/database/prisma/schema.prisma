// Ghassalny database schema.
//
// TENANT BOUNDARY
// An Organization is a car wash operator and the top-level tenant. Every business-facing record
// (branches, services, working hours, availability blocks, staff assignments, bookings) resolves
// to exactly one organization. Customers and platform admins are global users.
//
// Cross-tenant links are made impossible at the database level: child tables carry
// `organizationId` and reference their parents through composite foreign keys on
// (id, organizationId). A booking therefore cannot point at a branch or service from another
// organization even if application code has a bug.
//
// Rules the schema cannot express in Prisma (exclusion and check constraints) are added in
// migration SQL. See docs/architecture/booking-engine-invariants.md.
//
// Enum values for UserRole, BookingStatus, BookingSource, VehicleType, and AvailabilityBlockReason
// must stay identical to shared/contracts. src/enum-parity.ts fails typecheck if they drift.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Organizations (GHA-32)
// ---------------------------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// A car wash operator (tenant). Owns branches, services, staff assignments, and bookings.
model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String
  /// URL-safe unique identifier, e.g. for admin URLs or white-label config.
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments    UserRoleAssignment[]
  branches           Branch[]
  services           Service[]
  branchServices     BranchService[]
  staffAssignments   BranchStaffAssignment[]
  workingHours       BranchWorkingHours[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------------------------
// Users and roles (GHA-33)
// ---------------------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
  /// Account deleted by the user (App Store 5.1.1(v)); personal fields are anonymized.
  DELETED
}

enum UserRole {
  CUSTOMER
  WORKER
  BUSINESS_ADMIN
  PLATFORM_ADMIN
}

enum Locale {
  en
  ar
}

/// Anyone who signs in: customers, station workers, business admins, platform admins.
/// What a user may do comes from their role assignments, not from this row.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase. Unique across the platform.
  email           String     @unique
  /// E.164 format (e.g. +201001234567). Stored unverified in the MVP; OTP comes later.
  phone           String?    @unique
  fullName        String     @map("full_name")
  /// Null for accounts that cannot sign in with a password (e.g. future OTP-only accounts).
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  preferredLocale Locale     @default(en) @map("preferred_locale")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments  UserRoleAssignment[]
  vehicles         Vehicle[]
  staffAssignments BranchStaffAssignment[]
  customerBookings Booking[]               @relation("BookingCustomer")
  createdBookings  Booking[]               @relation("BookingCreatedBy")
  statusChanges    BookingStatusHistory[]
  createdBlocks    AvailabilityBlock[]
  authSessions     AuthSession[]

  @@map("users")
}

/// Grants a role to a user. WORKER and BUSINESS_ADMIN must name an organization (tenant-scoped);
/// CUSTOMER and PLATFORM_ADMIN must not. Enforced by the `user_role_assignments_scope_check`
/// constraint in migration SQL.
model UserRoleAssignment {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           UserRole
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, role, organizationId])
  @@index([organizationId, role])
  @@map("user_role_assignments")
}

/// A signed-in device. Holds the SHA-256 hash of the current refresh token (never the token).
/// Revoked on logout and account deletion. See docs/adr/0003-free-first-authentication.md.
model AuthSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------------------------
// Vehicles (GHA-34)
// ---------------------------------------------------------------------------------------------

enum VehicleType {
  SEDAN
  HATCHBACK
  SUV
  PICKUP
  VAN
}

/// A customer's car. Soft-deleted via `deletedAt` because past bookings reference it.
model Vehicle {
  id          String      @id @default(uuid(7)) @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  nickname    String?
  /// Free text: Egyptian plates mix Arabic letters and digits.
  plateNumber String      @map("plate_number")
  vehicleType VehicleType @map("vehicle_type")
  make        String?
  model       String?
  color       String?
  notes       String?
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([ownerId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------------------------
// Station brands and branches (GHA-35)
// ---------------------------------------------------------------------------------------------

/// A petrol station brand that hosts car washes. A platform-level catalog, not tenant data:
/// several operators can run washes at stations of the same brand.
model StationBrand {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches Branch[]

  @@map("station_brands")
}

enum BranchStatus {
  /// Being set up by the admin; hidden from customers.
  DRAFT
  ACTIVE
  /// Temporarily or permanently closed; hidden from customers.
  INACTIVE
}

/// A car wash location, usually inside a petrol station. Coordinates are entered manually
/// (free-first maps, see docs/product/free-first-constraints.md).
model Branch {
  id                  String       @id @default(uuid(7)) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  stationBrandId      String?      @map("station_brand_id") @db.Uuid
  name                String
  nameAr              String?      @map("name_ar")
  slug                String
  status              BranchStatus @default(DRAFT)
  phone               String?
  addressLine         String       @map("address_line")
  addressLineAr       String?      @map("address_line_ar")
  /// Neighbourhood used for search and display, e.g. "Nasr City".
  area                String
  areaAr              String?      @map("area_ar")
  city                String
  /// WGS 84 decimal degrees. Ranges are enforced by `branches_coordinates_check`.
  latitude            Float
  longitude           Float
  /// IANA zone used to interpret working hours.
  timeZone            String       @default("Africa/Cairo") @map("time_zone")
  /// How many cars can be washed at the same time. See booking invariants section 2.
  washBays            Int          @default(1) @map("wash_bays")
  /// Customer slot grid in minutes.
  slotIntervalMinutes Int          @default(30) @map("slot_interval_minutes")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stationBrand       StationBrand?           @relation(fields: [stationBrandId], references: [id], onDelete: SetNull)
  branchServices     BranchService[]
  staffAssignments   BranchStaffAssignment[]
  workingHours       BranchWorkingHours[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]

  /// Target for composite foreign keys that keep children inside the same tenant.
  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([status, latitude, longitude])
  @@map("branches")
}

/// Assigns a worker or admin to a branch they may operate.
model BranchStaffAssignment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([userId])
  @@map("branch_staff_assignments")
}

// ---------------------------------------------------------------------------------------------
// Services and branch pricing (GHA-36)
// ---------------------------------------------------------------------------------------------

/// An operator's service catalog entry, e.g. "Exterior wash" or "Full interior and exterior".
model Service {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  nameAr         String?  @map("name_ar")
  description    String?
  descriptionAr  String?  @map("description_ar")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchServices BranchService[]
  bookings       Booking[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("services")
}

/// A service as offered at one branch, with that branch's price and duration.
model BranchService {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  /// Price in the currency's minor unit (piasters for EGP) to avoid floating-point money.
  priceMinorUnits Int      @map("price_minor_units")
  currency        String   @default("EGP")
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([branchId, serviceId])
  @@map("branch_services")
}

// ---------------------------------------------------------------------------------------------
// Working hours (GHA-37)
// ---------------------------------------------------------------------------------------------

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

/// One opening interval for a branch on a day of the week, in the branch's local time.
/// A day with no rows is closed. Several rows on one day model split shifts (e.g. a Friday
/// prayer break). Times are minutes after local midnight; 0-1440 covers a 24-hour day.
/// Date-specific closures (holidays, maintenance) are availability blocks, not hours.
model BranchWorkingHours {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  dayOfWeek      DayOfWeek @map("day_of_week")
  opensAtMinute  Int       @map("opens_at_minute")
  closesAtMinute Int       @map("closes_at_minute")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([branchId, dayOfWeek, opensAtMinute])
  @@map("branch_working_hours")
}

// ---------------------------------------------------------------------------------------------
// Availability blocks (GHA-38)
// ---------------------------------------------------------------------------------------------

enum AvailabilityBlockReason {
  CLOSURE
  MAINTENANCE
  BREAK
  OTHER
}

/// A period when a branch takes no bookings. Blocks the whole branch.
model AvailabilityBlock {
  id              String                  @id @default(uuid(7)) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  branchId        String                  @map("branch_id") @db.Uuid
  startsAt        DateTime                @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime                @map("ends_at") @db.Timestamptz(3)
  reason          AvailabilityBlockReason
  note            String?
  createdByUserId String?                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([branchId, startsAt])
  @@map("availability_blocks")
}

// ---------------------------------------------------------------------------------------------
// Bookings and status history (GHA-39)
// ---------------------------------------------------------------------------------------------

enum BookingStatus {
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  CUSTOMER_APP
  WALK_IN
}

/// A reserved car wash slot. Price, duration, contact, and vehicle details are snapshots taken
/// at booking time (booking invariants section 6). Overlap per bay is prevented by the
/// `bookings_no_overlap_per_bay` exclusion constraint in migration SQL.
model Booking {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Short human-friendly code shown to customers and workers, e.g. "GH7K3P9".
  reference      String        @unique
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  /// Null for walk-ins without an account.
  customerId     String?       @map("customer_id") @db.Uuid
  vehicleId      String?       @map("vehicle_id") @db.Uuid
  source         BookingSource
  status         BookingStatus @default(CONFIRMED)
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  bayNumber      Int           @map("bay_number")

  serviceName     String       @map("service_name")
  durationMinutes Int          @map("duration_minutes")
  priceMinorUnits Int          @map("price_minor_units")
  currency        String
  contactName     String       @map("contact_name")
  contactPhone    String?      @map("contact_phone")
  vehicleType     VehicleType? @map("vehicle_type")
  vehiclePlate    String?      @map("vehicle_plate")
  notes           String?

  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  service       Service                @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer      User?                  @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  vehicle       Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  statusHistory BookingStatusHistory[]

  @@index([branchId, startsAt])
  @@index([customerId, startsAt])
  @@index([organizationId, startsAt])
  @@map("bookings")
}

/// Append-only log of booking status changes. The first row (fromStatus = null) is creation.
model BookingStatusHistory {
  id              String         @id @default(uuid(7)) @db.Uuid
  bookingId       String         @map("booking_id") @db.Uuid
  fromStatus      BookingStatus? @map("from_status")
  toStatus        BookingStatus  @map("to_status")
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}
