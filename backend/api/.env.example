# Backend API configuration, validated by apiEnvSchema in @ghassalny/config.
# Copy to `.env`. Every value here is a free, local-only default.

NODE_ENV=development
API_PORT=4000

# Local PostgreSQL from `pnpm db:up`.
DATABASE_URL=postgresql://ghassalny:ghassalny_dev_password@localhost:5432/ghassalny?schema=public

# Signs auth tokens. Must be 32+ characters. The API refuses to start in production while the
# value still contains "dev-only". Generate a real one with: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me-before-any-deploy

# Comma-separated browser origins allowed to call the API (the admin web app).
# The iOS app is a native client and does not need a CORS entry.
CORS_ALLOWED_ORIGINS=http://localhost:3000
