{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
