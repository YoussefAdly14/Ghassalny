{
  "name": "@ghassalny/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, and database client. Server-side only.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset && prisma db seed"
  },
  "dependencies": {
    "@ghassalny/config": "workspace:*",
    "@ghassalny/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "dotenv": "^18.0.6",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
