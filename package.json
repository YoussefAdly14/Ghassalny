{
  "name": "ghassalny",
  "private": true,
  "description": "Car wash discovery, booking, and operations platform for Egypt.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @ghassalny/database db:generate",
    "db:migrate": "pnpm --filter @ghassalny/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @ghassalny/database db:migrate:deploy",
    "db:studio": "pnpm --filter @ghassalny/database db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
