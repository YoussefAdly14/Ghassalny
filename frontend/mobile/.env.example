# Customer iOS app configuration, validated by mobileEnvSchema in @ghassalny/config.
# Copy to `.env`. EXPO_PUBLIC_* values are compiled into the app binary that ships to the
# App Store, so never put secrets or private keys here.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# iOS Simulator on a Mac can use localhost. A physical iPhone running Expo Go must use your
# computer's LAN IP instead, e.g. http://192.168.1.20:4000.
# Production builds must use https:// because iOS App Transport Security blocks plain HTTP.
EXPO_PUBLIC_API_URL=http://localhost:4000
